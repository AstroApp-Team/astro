{
  "name": "astro",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc -b && vp build",
    "preview": "vp preview",
    "prepare": "vp config",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "theatre:state": "node scripts/theatre-state.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply astro --local",
    "db:migrate:remote": "wrangler d1 migrations apply astro --remote",
    "deploy": "pnpm run build && wrangler deploy",
    "build:native": "tsc -b && vp build --mode capacitor",
    "cap:sync": "pnpm run build:native && cap sync",
    "cap:run": "pnpm run build:native && cap run android"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.79",
    "@capacitor/core": "8.5.0",
    "@hono/zod-validator": "0.9.0",
    "@ionic/react": "9.0.0",
    "@ionic/react-router": "9.0.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@tanstack/react-query": "5.101.4",
    "@theatre/core": "0.7.2",
    "@theatre/r3f": "0.7.2",
    "ai": "^7.0.76",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.3",
    "ionicons": "8.1.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "6.30.6",
    "react-router-dom": "6.30.6",
    "three": "0.186.1",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/cli": "8.5.0",
    "@capacitor/ios": "8.5.0",
    "@cloudflare/vite-plugin": "1.53.1",
    "@cloudflare/vitest-plugin": "1.0.0",
    "@theatre/studio": "0.7.2",
    "@types/node": "24.10.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/runner": "catalog:",
    "@vitest/snapshot": "catalog:",
    "drizzle-kit": "0.31.10",
    "oxc-transform-react": "0.145.0",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.125.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  }
}
