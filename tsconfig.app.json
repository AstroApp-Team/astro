{
  "extends": "./tsconfig.strict.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    /* Theatre.js exports its animation state as JSON; infrastructure/theatre/states imports it. */
    "resolveJsonModule": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",

    /**
     * Clean-architecture layer aliases, mirrored in vite.config.ts. `@shared/*`
     * is not in the brief's list but is needed: `core/` imports the realtime
     * rate constants, and a `../../../../shared` walk from three layers down is
     * the kind of path that breaks the first time a folder is renamed.
     */
    "paths": {
      "@core/*": ["./src/core/*"],
      "@infra/*": ["./src/infrastructure/*"],
      "@presentation/*": ["./src/presentation/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  /**
   * `shared` holds the Zod schemas both sides use. `worker` and
   * `worker-configuration.d.ts` are here because src/lib/api.ts imports the
   * Hono `AppType` for RPC — that type transitively references Workers globals
   * (CloudflareBindings, D1Database), so the client project must be able to
   * resolve them. Nothing from worker/ is emitted into the client bundle; the
   * import is type-only and erased.
   */
  "include": ["src", "shared", "worker", "worker-configuration.d.ts"]
}
